{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #colophon {
    {%- if section.settings.brand_primary != blank -%}
      --brand-primary: {{ section.settings.brand_primary }};
    {%- endif -%}
    {%- if section.settings.brand_primary_light != blank -%}
      --brand-primary-light: {{ section.settings.brand_primary_light }};
    {%- endif -%}
    {%- if section.settings.brand_secondary != blank -%}
      --brand-secondary: {{ section.settings.brand_secondary }};
    {%- endif -%}
    {%- if section.settings.footer_text_color != blank -%}
      --white: {{ section.settings.footer_text_color }};
    {%- endif -%}
  }
{%- endstyle -%}

<footer id="colophon" class="site-footer color-{{ section.settings.color_scheme }} gradient" role="contentinfo">
  <div class="footer-main">
    <div class="container c-w-1350">
      <div class="row row-gap-36 align-items-lg-end align-items-center">
        <div class="col-lg-5">
          <div class="footer-logo_main ta-lg-l ta-c">
            <a href="{{ routes.root_url }}" class="footer-logo-link" aria-label="{{ shop.name | escape }}">
              {%- if section.settings.footer_logo != blank -%}
                <img
                  class="footer-logo"
                  src="{{ section.settings.footer_logo | image_url: width: 500 }}"
                  alt="{{ section.settings.footer_logo.alt | default: shop.name | escape }}"
                  loading="lazy"
                  width="{{ section.settings.footer_logo.width }}"
                  height="{{ section.settings.footer_logo.height }}"
                >
              {%- elsif settings.logo != blank -%}
                <img
                  class="footer-logo"
                  src="{{ settings.logo | image_url: width: 500 }}"
                  alt="{{ settings.logo.alt | default: shop.name | escape }}"
                  loading="lazy"
                  width="{{ settings.logo.width }}"
                  height="{{ settings.logo.height }}"
                >
              {%- else -%}
                <h2 class="footer-shop-name">{{ shop.name }}</h2>
              {%- endif -%}
            </a>
          </div>

          <div class="footer_contact_info d-flex flex-column align-items-lg-start align-items-center ta-lg-l ta-c row-gap-4 pt-md">
            {%- if section.settings.phone_number != blank -%}
              <div class="phone--number contact-info">
                <h5>{{ section.settings.phone_heading | default: 'Call Us' }}</h5>
                <a aria-label="Call us" href="{{ section.settings.phone_url | default: 'tel:' | append: section.settings.phone_number }}">
                  {{ section.settings.phone_number | escape }}
                </a>
              </div>
            {%- endif -%}

            {%- if section.settings.email != blank -%}
              <div class="email--us contact-info">
                <h5>{{ section.settings.email_heading | default: 'EMAIL US' }}</h5>
                <a aria-label="Email us" href="{{ section.settings.email_url | default: 'mailto:' | append: section.settings.email }}">
                  {{ section.settings.email | escape }}
                </a>
              </div>
            {%- endif -%}

            {%- if section.settings.address != blank -%}
              <div class="address contact-info">
                <h5>{{ section.settings.address_heading | default: 'Located At' }}</h5>
                {%- if section.settings.address_map_url != blank -%}
                  <a aria-label="Find us on Google Maps" href="{{ section.settings.address_map_url }}" target="_blank" rel="noopener noreferrer">
                    {{ section.settings.address | escape }}
                  </a>
                {%- else -%}
                  <span>{{ section.settings.address | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.show_social_links -%}
            <div class="footer-social mx-lg-0 mx-auto d-flex justify-content-lg-start justify-content-center align-items-center row-gap-3 pt-4">
              {%- if settings.social_facebook_link != blank -%}
                <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_twitter_link != blank -%}
                <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="col-lg-7 d-lg-block d-none">
          <nav class="pt-def" aria-label="footer navigation">
            {%- assign footer_menu = linklists[section.settings.menu] -%}
            {%- if footer_menu.links.size > 0 -%}
              <ul class="footer-nav d-flex justify-content-between align-items-start">
                {%- for link in footer_menu.links -%}
                  <li class="{% if link.links != blank %}has-submenu{% endif %}">
                    <a href="{{ link.url }}">{{ link.title | escape }}</a>
                    {%- if link.links != blank -%}
                      <ul class="sub-menu">
                        {%- for childlink in link.links -%}
                          <li>
                            <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-copyright">
    <div class="container c-w-1350">
      <div class="row row-gap-3 copyright-row {% if section.settings.show_brand_attribution %}justify-content-xl-between{% else %}justify-content-center{% endif %} justify-content-center align-items-center ta-lg-l ta-c">
        <div class="col-auto">
          <div class="copyright">
            <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.{% if section.settings.company_license != blank %} | License NC: {{ section.settings.company_license }}{% endif %}</p>
            {%- if section.settings.footer_copyright_links != blank -%}
              <span class="copyright-links">{{ section.settings.footer_copyright_links }}</span>
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_brand_attribution -%}
          <div class="col-auto d-flex justify-content-lg-end justify-content-center">
            <div class="footer-brand justify-content-end d-flex align-items-center">
              <p class="d-flex align-items-center">
                Site design & SEO by
                <a
                  rel="nofollow"
                  aria-label="{{ section.settings.brand_attribution_text | default: 'About Hook Agency' | escape }}"
                  href="{{ section.settings.brand_attribution_url | default: 'https://hookagency.com' }}"
                  target="_blank"
                  class="brand-attr"
                >
                  {%- if section.settings.brand_attribution_logo != blank -%}
                    <img
                      class="hook-brand"
                      src="{{ section.settings.brand_attribution_logo | image_url: width: 50 }}"
                      alt="Agency Logo"
                      width="24"
                      height="24"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img
                      class="hook-brand"
                      src="{{ 'hook-icon-thick-logo-white.svg' | asset_url }}"
                      alt="Hook Agency Logo"
                      width="24"
                      height="24"
                      loading="lazy"
                    >
                  {%- endif -%}
                </a>
              </p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer Logo"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo Image"
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "text",
      "id": "phone_heading",
      "label": "Phone Heading",
      "default": "Call Us"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "(555) 123-4567"
    },
    {
      "type": "url",
      "id": "phone_url",
      "label": "Phone Link URL"
    },
    {
      "type": "text",
      "id": "email_heading",
      "label": "Email Heading",
      "default": "EMAIL US"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "info@yourdomain.com"
    },
    {
      "type": "url",
      "id": "email_url",
      "label": "Email Link URL"
    },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Address Heading",
      "default": "Located At"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Physical Address",
      "default": "123 Business Way, Suite 100"
    },
    {
      "type": "url",
      "id": "address_map_url",
      "label": "Google Maps Link URL"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "Show Social Media Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "footer",
      "label": "Footer Menu"
    },
    {
      "type": "header",
      "content": "Copyright & Attribution"
    },
    {
      "type": "text",
      "id": "company_license",
      "label": "License Number (Optional)"
    },
    {
      "type": "inline_richtext",
      "id": "footer_copyright_links",
      "label": "Additional Copyright Links"
    },
    {
      "type": "checkbox",
      "id": "show_brand_attribution",
      "label": "Show Agency Attribution",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_attribution_text",
      "label": "Attribution Text",
      "default": "About Hook Agency"
    },
    {
      "type": "url",
      "id": "brand_attribution_url",
      "label": "Attribution URL"
    },
    {
      "type": "image_picker",
      "id": "brand_attribution_logo",
      "label": "Attribution Logo Image"
    },
    {
      "type": "header",
      "content": "Color Scheme & Styling"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "brand_primary",
      "label": "Footer Background Color",
      "default": "#163c4e"
    },
    {
      "type": "color",
      "id": "brand_primary_light",
      "label": "Accent / Heading Color",
      "default": "#7eaec4"
    },
    {
      "type": "color",
      "id": "brand_secondary",
      "label": "Hover Accent Color",
      "default": "#d4a373"
    },
    {
      "type": "color",
      "id": "footer_text_color",
      "label": "Footer Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
