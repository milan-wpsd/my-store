{{ 'section-hero-main.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #hero-{{ section.id }} {
    {%- assign overlay_opacity_fraction = section.settings.overlay_opacity | divided_by: 100.0 -%}
    {%- if section.settings.overlay_color != blank -%}
      --hero-overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity_fraction }};
    {%- endif -%}
    {%- if section.settings.text_color != blank -%}
      --hero-text-color: {{ section.settings.text_color }};
    {%- endif -%}
    {%- if section.settings.button_bg_color != blank -%}
      --hero-btn-bg: {{ section.settings.button_bg_color }};
    {%- endif -%}
    {%- if section.settings.button_text_color != blank -%}
      --hero-btn-text: {{ section.settings.button_text_color }};
    {%- endif -%}
    {%- if section.settings.social_bg_color != blank -%}
      --hero-social-bg: {{ section.settings.social_bg_color }};
    {%- endif -%}
  }
{%- endstyle -%}

<section id="hero-{{ section.id }}" class="hero hero--main" aria-label="{{ section.settings.accessibility_label | default: 'page introduction' | escape }}">
  {%- assign poster_url = '' -%}
  {%- if section.settings.hero_image != blank -%}
    {%- assign poster_url = section.settings.hero_image | image_url: width: 2000 -%}
  {%- endif -%}

  {%- if section.settings.hero_video != blank -%}
    <div class="hero-banner-video bg--image-abs overlay">
      {{
        section.settings.hero_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          image_size: '2048x'
      }}
    </div>
  {%- elsif section.settings.hero_video_url != blank -%}
    <div class="hero-banner-video bg--image-abs overlay">
      <video autoplay playsinline muted loop preload="auto"{% if poster_url != blank %} poster="{{ poster_url }}"{% endif %}>
        <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
      </video>
    </div>
  {%- elsif section.settings.hero_image != blank -%}
    <picture class="hero-bg-img bg--image-abs overlay">
      {{
        section.settings.hero_image
        | image_url: width: 2500
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 1780, 2000, 2500',
          alt: section.settings.hero_main_title | default: shop.name | escape
      }}
    </picture>
  {%- else -%}
    <div class="hero-bg-img bg--image-abs overlay">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="container">
    <div class="main_inner d-flex flex-column justify-content-center">
      <div class="row justify-content-lg-center mt-auto">
        <div class="col-xl-8 col-lg-10">
          <div class="hero-content d-flex flex-column align-items-center ta-c row-gap-lg-30 c-wt">
            <header class="section-header">
              {%- if section.settings.hero_micro_title != blank -%}
                <h2 class="micro">{{ section.settings.hero_micro_title | escape }}</h2>
              {%- endif -%}
              {%- if section.settings.hero_main_title != blank -%}
                <h1 class="lvl-1">{{ section.settings.hero_main_title }}</h1>
              {%- endif -%}
            </header>

            {%- if section.settings.hero_content != blank -%}
              <div class="content">
                {{ section.settings.hero_content }}
              </div>
            {%- endif -%}

            {%- if section.settings.hero_cta_title != blank -%}
              <div class="btn-wrap btn-wrap--hero">
                <a
                  class="btn {{ section.settings.hero_cta_link_style }}"
                  href="{{ section.settings.hero_cta_url | default: '#' }}"
                  {% if section.settings.hero_cta_target == '_blank' %}
                    target="_blank" rel="noopener noreferrer"
                  {% else %}
                    target="_self"
                  {% endif %}
                  aria-label="{{ section.settings.hero_cta_title | escape }}"
                >
                  <span>{{ section.settings.hero_cta_title | escape }}</span>
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- assign rating_blocks = section.blocks | where: 'type', 'social_rating' -%}
      {%- assign highlight_blocks = section.blocks | where: 'type', 'highlight' -%}

      {%- if rating_blocks.size > 0 or highlight_blocks.size > 0 -%}
        <div class="social-wrapper d-flex flex-xl-row flex-column row-gap-4 justify-content-between align-items-center mt-auto">
          {%- if rating_blocks.size > 0 -%}
            <div class="social-ratings d-flex">
              {%- for block in rating_blocks -%}
                <div class="social__items flex-sm-row flex-column d-flex align-items-center" {{ block.shopify_attributes }}>
                  {%- if block.settings.headshot_1 != blank or block.settings.headshot_2 != blank or block.settings.headshot_3 != blank -%}
                    <div class="social__item d-flex align-items-center">
                      {%- if block.settings.headshot_1 != blank -%}
                        <picture class="social__item__icon obj-cont">
                          {{ block.settings.headshot_1 | image_url: width: 100 | image_tag: loading: 'lazy', alt: 'Customer avatar' }}
                        </picture>
                      {%- endif -%}
                      {%- if block.settings.headshot_2 != blank -%}
                        <picture class="social__item__icon obj-cont">
                          {{ block.settings.headshot_2 | image_url: width: 100 | image_tag: loading: 'lazy', alt: 'Customer avatar' }}
                        </picture>
                      {%- endif -%}
                      {%- if block.settings.headshot_3 != blank -%}
                        <picture class="social__item__icon obj-cont">
                          {{ block.settings.headshot_3 | image_url: width: 100 | image_tag: loading: 'lazy', alt: 'Customer avatar' }}
                        </picture>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="social__item__desc d-flex align-items-center">
                    {%- if block.settings.social_icon != blank -%}
                      {{ block.settings.social_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: 'Review platform logo' }}
                    {%- endif -%}

                    <svg class="rating-stars" x="0px" y="0px" viewBox="0 0 56.6 11.3" style="enable-background:new 0 0 56.6 11.3;" xml:space="preserve" aria-label="5 stars rating">
                      <g id="rating-2" transform="translate(-8127.431 -4252.471)">
                        <g id="star-ratings-logo" transform="translate(4.002 -9.605)">
                          <g id="rating-3" transform="translate(-0.561 6.461)">
                            <path fill="#FBBC05" id="Star-11" d="M8179.8,4260.2l-3.4-0.2l-1.3-3.2l-1.3,3.2l-3.4,0.2l2.6,2.2l-0.9,3.4l2.9-1.8l2.9,1.8l-0.9-3.4 L8179.8,4260.2z"/>
                            <path fill="#FBBC05" id="Star-12" d="M8168.4,4260.2l-3.4-0.2l-1.3-3.2l-1.3,3.2l-3.4,0.2l2.6,2.2l-0.9,3.4l2.9-1.8l2.9,1.8l-0.9-3.4 L8168.4,4260.2z"/>
                            <path fill="#FBBC05" id="Star-13" d="M8157.1,4260.2l-3.4-0.2l-1.3-3.2l-1.3,3.2l-3.4,0.2l2.6,2.2l-0.9,3.4l2.9-1.8l2.9,1.8l-0.9-3.4 L8157.1,4260.2z"/>
                            <path fill="#FBBC05" id="Star-14" d="M8145.7,4260.2l-3.4-0.2l-1.3-3.2l-1.3,3.2l-3.4,0.2l2.6,2.2l-0.9,3.4l2.9-1.8l2.9,1.8l-0.9-3.4 L8145.7,4260.2z"/>
                            <path fill="#FBBC05" id="Star-15" d="M8134.3,4260.2l-3.4-0.2l-1.3-3.2l-1.3,3.2l-3.4,0.2l2.6,2.2l-0.9,3.4l2.9-1.8l2.9,1.8l-0.9-3.4 L8134.3,4260.2z"/>
                          </g>
                        </g>
                      </g>
                    </svg>

                    {%- if block.settings.rating_number != blank or block.settings.rating_description != blank -%}
                      <p><strong>{{ block.settings.rating_number }}</strong> {{ block.settings.rating_description }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if highlight_blocks.size > 0 -%}
            <div class="highlights d-flex align-items-center">
              {%- for block in highlight_blocks -%}
                {%- if block.settings.title != blank -%}
                  <div class="highlights__item" {{ block.shopify_attributes }}>
                    {{ block.settings.title | escape }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Main",
  "tag": "section",
  "class": "section section-hero-main",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero Headings & Content"
    },
    {
      "type": "text",
      "id": "hero_micro_title",
      "label": "Micro Title (Eyebrow)",
      "default": "Welcome to Our Store"
    },
    {
      "type": "inline_richtext",
      "id": "hero_main_title",
      "label": "Main Title",
      "default": "Modern Craftsmanship Designed for You"
    },
    {
      "type": "richtext",
      "id": "hero_content",
      "label": "Hero Content / Description",
      "default": "<p>Discover thoughtfully designed collections made from premium materials and built to elevate your daily routine.</p>"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "hero_cta_title",
      "label": "Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "hero_cta_target",
      "label": "Button Target",
      "options": [
        {
          "value": "_self",
          "label": "Same tab"
        },
        {
          "value": "_blank",
          "label": "New tab"
        }
      ],
      "default": "_self"
    },
    {
      "type": "select",
      "id": "hero_cta_link_style",
      "label": "Button Style",
      "options": [
        {
          "value": "btn-primary",
          "label": "Solid (Primary)"
        },
        {
          "value": "btn-outline",
          "label": "Outline"
        }
      ],
      "default": "btn-primary"
    },
    {
      "type": "header",
      "content": "Background Media"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background Image / Video Poster"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Background Video (Shopify hosted)"
    },
    {
      "type": "text",
      "id": "hero_video_url",
      "label": "Background Video URL (Optional MP4 link)"
    },
    {
      "type": "header",
      "content": "Colors & Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#163c4e"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 60
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "social_bg_color",
      "label": "Mobile Trust Bar Background",
      "default": "#163c4e"
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Section Accessibility Label",
      "default": "page introduction"
    }
  ],
  "blocks": [
    {
      "type": "social_rating",
      "name": "Social Rating",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "headshot_1",
          "label": "Customer Avatar 1"
        },
        {
          "type": "image_picker",
          "id": "headshot_2",
          "label": "Customer Avatar 2"
        },
        {
          "type": "image_picker",
          "id": "headshot_3",
          "label": "Customer Avatar 3"
        },
        {
          "type": "image_picker",
          "id": "social_icon",
          "label": "Platform Icon (e.g. Trustpilot/Google)"
        },
        {
          "type": "text",
          "id": "rating_number",
          "label": "Rating Score",
          "default": "4.9/5"
        },
        {
          "type": "text",
          "id": "rating_description",
          "label": "Rating Description",
          "default": "from 1,200+ reviews"
        }
      ]
    },
    {
      "type": "highlight",
      "name": "Feature Highlight",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Highlight Text",
          "default": "Fast Free Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Main",
      "settings": {
        "hero_micro_title": "Welcome to Our Store",
        "hero_main_title": "Modern Craftsmanship Designed for You",
        "hero_content": "<p>Discover thoughtfully designed collections made from premium materials and built to elevate your daily routine.</p>",
        "hero_cta_title": "Shop the Collection",
        "overlay_color": "#163c4e",
        "overlay_opacity": 60
      },
      "blocks": [
        {
          "type": "social_rating",
          "settings": {
            "rating_number": "4.9/5",
            "rating_description": "from 1,200+ customer reviews"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Free Worldwide Delivery"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "30-Day Money-Back Guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
